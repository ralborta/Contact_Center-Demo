# ── Postgres (requerido) ──────────────────────────────────────────
DATABASE_URL=postgresql://citas:citas@postgres:5432/citas_hospital?schema=public

# ── API ───────────────────────────────────────────────────────────
APP_PORT=3000
PORT=3000
JWT_SECRET=cambiar-en-produccion
CORS_ORIGIN=https://citas-hospital.TU_DOMINIO.easypanel.host
TZ=America/La_Paz

# Migraciones: siempre al arrancar.
# Seed demo (especialidades, doctores, Juan Pérez, etc.): solo si true/1/always
RUN_SEED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambiar-password-admin-demo

# ── Agente de voz (server tools + webhooks) ───────────────────────
# Header: X-Agent-Secret  o  X-Webhook-Token
AGENT_API_SECRET=cambiar-secreto-agente
ELEVENLABS_WEBHOOK_TOKEN=cambiar-secreto-agente

# Opcional — sync/grabaciones (no se muestran en la UI)
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=

# ── Frontend (build arg / env de Easypanel web) ───────────────────
# NEXT_PUBLIC_API_URL=https://citas-hospital-api.TU_DOMINIO.easypanel.host

# Redis NO es requerido en esta rama (campañas en Postgres).
# REDIS_URL=
