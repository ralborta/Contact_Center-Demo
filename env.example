# ── Postgres (requerido) ──────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASS@postgres:5432/citas_hospital?schema=public

# ── API ───────────────────────────────────────────────────────────
APP_PORT=3000
PORT=3000
JWT_SECRET=
CORS_ORIGIN=https://citas-hospital.TU_DOMINIO.easypanel.host
TZ=America/La_Paz

# Migraciones: siempre al arrancar.
# Seed demo: solo si true/1/always
RUN_SEED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# ── Agente de voz (server tools + webhooks) ───────────────────────
# Header: X-Agent-Secret  o  X-Webhook-Token
AGENT_API_SECRET=
ELEVENLABS_WEBHOOK_TOKEN=

# Simulador /telefono — signed URL (no exponer al frontend)
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=agent_8301m89vh2zsf3jrcs1h3ej36nk2
# SIMULATOR_CALLER_PHONE=59170111222

# ── Frontend (build arg Easypanel web) ────────────────────────────
# NEXT_PUBLIC_API_URL=https://citas-hospital-api.TU_DOMINIO.easypanel.host
