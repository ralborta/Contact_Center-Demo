{
  "name": "citas-hospital",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/cc-backend && npm run build --workspace=apps/cc-frontend",
    "test": "npm test --workspace=apps/cc-backend",
    "db:seed": "npm run seed --workspace=apps/cc-backend",
    "dev:backend": "npm run dev --workspace=apps/cc-backend",
    "dev:frontend": "npm run dev --workspace=apps/cc-frontend",
    "prisma:generate": "npm run prisma:generate --workspace=apps/cc-backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/cc-backend",
    "prisma:studio": "npm run prisma:studio --workspace=apps/cc-backend"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
