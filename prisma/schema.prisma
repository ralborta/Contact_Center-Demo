generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / consola ───────────────────────────────────────────────

model Profile {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // ADMIN, AGENT, DOCTOR, VIEWER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("profiles")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  profileId    String
  active       Boolean  @default(true)
  doctorId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  doctor  Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([profileId])
  @@map("users")
}

enum ActorType {
  USER
  SYSTEM
  AGENT
  PATIENT
  DOCTOR
}

model AuditLog {
  id         String    @id @default(uuid())
  ts         DateTime  @default(now())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([ts])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Llamadas / interacciones ─────────────────────────────────────

enum Channel {
  CALL
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum InteractionStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  ABANDONED
  FAILED
}

enum Outcome {
  RESOLVED
  ESCALATED
  TRANSFERRED
  NO_ANSWER
  VOICEMAIL
  UNKNOWN
}

enum Provider {
  VOICE_AGENT
  GENERIC
}

model Interaction {
  id                     String            @id @default(uuid())
  channel                Channel           @default(CALL)
  direction              Direction
  status                 InteractionStatus @default(NEW)
  startedAt              DateTime?
  endedAt                DateTime?
  from                   String
  to                     String
  patientId              String?
  queue                  String?
  assignedAgent          String?
  aiHandled              Boolean           @default(true)
  outcome                Outcome?
  intent                 String?
  resultCode             String? // APPOINTMENT_BOOKED, RESCHEDULED, CANCELLED, NO_AVAILABILITY, etc.
  provider               Provider          @default(VOICE_AGENT)
  providerConversationId String?
  appointmentId          String?
  campaignJobId          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  events      InteractionEvent[]
  callDetail  CallDetail?
  patient     Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  campaignJob OutboundCampaignJob? @relation(fields: [campaignJobId], references: [id], onDelete: SetNull)

  @@unique([provider, providerConversationId])
  @@index([channel, startedAt])
  @@index([status, startedAt])
  @@index([from])
  @@index([patientId])
  @@index([appointmentId])
  @@map("interactions")
}

model InteractionEvent {
  id              String   @id @default(uuid())
  interactionId   String
  ts              DateTime @default(now())
  type            String
  provider        Provider
  providerEventId String?
  idempotencyKey  String?  @unique
  payload         Json
  createdAt       DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId, ts])
  @@map("interaction_events")
}

model CallDetail {
  id             String   @id @default(uuid())
  interactionId  String   @unique
  externalCallId String?
  recordingUrl   String?
  transcriptText String?  @db.Text
  summary        String?  @db.Text
  durationSec    Int?
  hangupReason   String?
  createdAt      DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@map("call_details")
}

// ─── Dominio hospitalario ─────────────────────────────────────────

model Specialty {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors       Doctor[]
  appointments  Appointment[]

  @@map("specialties")
}

enum DoctorStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Doctor {
  id                 String       @id @default(uuid())
  firstName          String
  lastName           String
  specialtyId        String
  consultorio        String?
  phone              String?
  email              String?
  defaultDurationMin Int          @default(30)
  status             DoctorStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  specialty   Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  schedules   DoctorSchedule[]
  exceptions  ScheduleException[]
  slots       Slot[]
  appointments Appointment[]
  user        User?

  @@index([specialtyId])
  @@index([status])
  @@index([lastName, firstName])
  @@map("doctors")
}

model DoctorSchedule {
  id           String @id @default(uuid())
  doctorId     String
  dayOfWeek    Int // 0=Domingo ... 6=Sábado
  startTime    String // "08:00"
  endTime      String // "12:00"
  slotDuration Int    @default(30)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

enum ExceptionType {
  BLOCK
  EXTRA
  HOLIDAY
}

model ScheduleException {
  id        String        @id @default(uuid())
  doctorId  String?
  date      DateTime      @db.Date
  startTime String? // null = día completo
  endTime   String?
  type      ExceptionType @default(BLOCK)
  reason    String?
  createdAt DateTime      @default(now())

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@index([date])
  @@map("schedule_exceptions")
}

enum SlotStatus {
  FREE
  RESERVED
  BLOCKED
  EXPIRED
}

model Slot {
  id        String     @id @default(uuid())
  doctorId  String
  startsAt  DateTime
  endsAt    DateTime
  status    SlotStatus @default(FREE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt, status])
  @@index([status, startsAt])
  @@map("slots")
}

model Patient {
  id               String   @id @default(uuid())
  firstName        String
  lastName         String
  documentId       String   @unique // CI
  phone            String
  normalizedPhone  String
  email            String?
  insurance        String?
  dateOfBirth      DateTime? @db.Date
  notes            String?  @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments Appointment[]
  interactions Interaction[]
  campaignJobs OutboundCampaignJob[]

  @@index([phone])
  @@index([normalizedPhone])
  @@index([lastName, firstName])
  @@map("patients")
}

enum AppointmentStatus {
  RESERVED
  CONFIRMED
  RESCHEDULED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  COMPLETED
  NO_SHOW
  NEEDS_RESCHEDULE
}

enum ChangeOrigin {
  PATIENT
  DOCTOR
  VOICE_AGENT
  OPERATOR
  SYSTEM
}

enum AppointmentChannel {
  PHONE_IN
  PHONE_OUT
  CONSOLE
}

model Appointment {
  id           String              @id @default(uuid())
  patientId    String
  doctorId     String
  specialtyId  String
  slotId       String              @unique
  status       AppointmentStatus   @default(RESERVED)
  channel      AppointmentChannel  @default(CONSOLE)
  reason       String?
  notes        String?
  /// conversation_id de ElevenLabs que creó/modificó esta cita (reservar/reprogramar/cancelar)
  voiceConversationId String?
  needsReschedule Boolean          @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  specialty    Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  slot         Slot                @relation(fields: [slotId], references: [id], onDelete: Restrict)
  changes      AppointmentChange[]
  interactions Interaction[]
  campaignJobs OutboundCampaignJob[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([specialtyId])
  @@index([status, createdAt])
  @@index([needsReschedule])
  @@index([voiceConversationId])
  @@map("appointments")
}

model AppointmentChange {
  id            String             @id @default(uuid())
  appointmentId String
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  fromSlotId    String?
  toSlotId      String?
  origin        ChangeOrigin
  actorId       String?
  reason        String?
  notified      Boolean            @default(false)
  createdAt     DateTime           @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_changes")
}

// ─── Campañas salientes ───────────────────────────────────────────

enum CampaignType {
  REMINDER
  CONFIRMATION
  DOCTOR_CANCEL_NOTICE
  RESCHEDULE_NOTICE
}

enum CampaignStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
}

enum CampaignJobStatus {
  PENDING
  CALLING
  CONFIRMED
  RESCHEDULED
  NO_ANSWER
  VOICEMAIL
  FAILED
  CANCELLED
}

model OutboundCampaign {
  id          String         @id @default(uuid())
  name        String
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  jobs OutboundCampaignJob[]

  @@map("outbound_campaigns")
}

model OutboundCampaignJob {
  id            String            @id @default(uuid())
  campaignId    String
  patientId     String
  appointmentId String?
  phone         String
  status        CampaignJobStatus @default(PENDING)
  attempts      Int               @default(0)
  lastAttemptAt DateTime?
  resultNotes   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  campaign    OutboundCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  interactions Interaction[]

  @@index([campaignId, status])
  @@index([status])
  @@map("outbound_campaign_jobs")
}

// ─── Configuración del agente ─────────────────────────────────────

model AgentConfig {
  id                  String   @id @default("default")
  hospitalName        String   @default("Hospital Central La Paz")
  greeting            String   @default("Buenos días, habla el asistente de citas del Hospital Central La Paz. ¿En qué puedo ayudarle?")
  businessHoursStart  String   @default("07:00")
  businessHoursEnd    String   @default("20:00")
  timezone            String   @default("America/La_Paz")
  transferMessage     String   @default("Lo derivo con un operador humano, un momento por favor.")
  closedMessage       String   @default("Nuestro horario de atención telefónica es de 7:00 a 20:00. Puede volver a llamar en ese horario.")
  transferEnabled     Boolean  @default(true)
  currency            String   @default("Bs")
  locale              String   @default("es-BO")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("agent_config")
}
